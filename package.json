{
  "name": "board-game-recs",
  "version": "0.0.0",
  "private": true,
  "description": "Board game recommendations for a group of friends: what to buy next, and what to play tonight.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksycz/board-game-recs.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.14.0"
}
