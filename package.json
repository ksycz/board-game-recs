{
  "name": "board-game-recs",
  "version": "0.0.0",
  "private": true,
  "description": "Board game recommendations for a group of friends: what to buy next, and what to play tonight.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
